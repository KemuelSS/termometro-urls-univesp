# Copie este arquivo para ".env" e preencha com os valores reais.
# O ".env" de verdade nunca deve ser commitado (já está no .gitignore).

# Obrigatória: chave da API do Google Safe Browsing.
GOOGLE_API_KEY=

# Opcional: string de conexão do banco de dados.
# Sem definir, a aplicação usa um arquivo SQLite local (banco_dados.db).
# Em produção (Render), aponta para a instância gerenciada de PostgreSQL.
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_do_banco
